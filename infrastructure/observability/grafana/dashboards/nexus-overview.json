{
  "uid": "nexus-overview",
  "title": "NEXUS — Infrastructure Overview",
  "tags": ["nexus", "infrastructure", "observability"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Monitoring Targets",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "sum(up)", "legendFormat": "Healthy targets", "refId": "A"}]
    },
    {
      "id": 2,
      "title": "PostgreSQL Database Size",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "sum(pg_database_size_bytes)", "legendFormat": "Database size", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []}
    },
    {
      "id": 3,
      "title": "RabbitMQ Ready Messages",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "sum(rabbitmq_queue_messages_ready)", "legendFormat": "Ready", "refId": "A"}]
    },
    {
      "id": 4,
      "title": ".NET Working Set Memory",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "targets": [{"expr": "dotnet_process_memory_working_set_bytes", "legendFormat": "{{job}} / {{instance}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []}
    },
    {
      "id": 5,
      "title": ".NET CPU Usage",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "targets": [{"expr": "rate(dotnet_process_cpu_time_seconds_total[5m])", "legendFormat": "{{job}} / {{instance}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []}
    },
    {
      "id": 6,
      "title": "PostgreSQL Active Connections",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "targets": [{"expr": "sum(pg_stat_activity_count)", "legendFormat": "Connections", "refId": "A"}]
    },
    {
      "id": 7,
      "title": "PostgreSQL Transaction Rate",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
      "targets": [{"expr": "sum(rate(pg_stat_database_xact_commit[5m]))", "legendFormat": "Commits/sec", "refId": "A"}]
    },
    {
      "id": 8,
      "title": "RabbitMQ Queue Messages",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 20, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum by (queue) (rabbitmq_queue_messages_ready)", "legendFormat": "{{queue}} ready", "refId": "A"},
        {"expr": "sum by (queue) (rabbitmq_queue_messages_unacked)", "legendFormat": "{{queue}} unacknowledged", "refId": "B"}
      ]
    },
    {
      "id": 9,
      "title": "RabbitMQ Consumers",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 20, "w": 12, "h": 8},
      "targets": [{"expr": "sum(rabbitmq_queue_consumers)", "legendFormat": "Consumers", "refId": "A"}]
    },
    {
      "id": 10,
      "title": "RabbitMQ Dead-Letter Rate",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 28, "w": 12, "h": 8},
      "targets": [{"expr": "rate(rabbitmq_global_messages_dead_lettered_confirmed_total[5m])", "legendFormat": "Dead-lettered/sec", "refId": "A"}]
    },
    {
      "id": 11,
      "title": "Traefik Open Connections",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 28, "w": 12, "h": 8},
      "targets": [{"expr": "sum by (entrypoint) (traefik_open_connections)", "legendFormat": "{{entrypoint}}", "refId": "A"}]
    },
    {
      "id": 12,
      "title": ".NET Exceptions",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 36, "w": 12, "h": 8},
      "targets": [{"expr": "sum(rate(dotnet_exceptions_total[5m]))", "legendFormat": "Exceptions/sec", "refId": "A"}]
    },
    {
      "id": 13,
      "title": "PostgreSQL Deadlocks",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 36, "w": 12, "h": 8},
      "targets": [{"expr": "sum(rate(pg_stat_database_deadlocks[5m]))", "legendFormat": "Deadlocks/sec", "refId": "A"}]
    },
    {
      "id": 14,
      "title": "Telemetry Messages Processed",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 44, "w": 6, "h": 8},
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0}, "overrides": []},
      "targets": [{"expr": "sum(increase(nexus_telemetry_messages_processed_total{exported_job=\"nexus-telemetry-worker\"}[$__range]))", "legendFormat": "Processed", "refId": "A"}]
    },
    {
      "id": 15,
      "title": "Telemetry Processing Throughput",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 6, "y": 44, "w": 9, "h": 8},
      "fieldConfig": {"defaults": {"unit": "suffix: msg/s"}, "overrides": []},
      "targets": [{"expr": "sum by (category) (rate(nexus_telemetry_messages_processed_total{exported_job=\"nexus-telemetry-worker\"}[5m]))", "legendFormat": "{{category}}", "refId": "A"}]
    },
    {
      "id": 16,
      "title": "Telemetry Processing Duration",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 15, "y": 44, "w": 9, "h": 8},
      "fieldConfig": {"defaults": {"unit": "ms"}, "overrides": []},
      "targets": [
        {"expr": "sum(rate(nexus_telemetry_processing_duration_milliseconds_sum{exported_job=\"nexus-telemetry-worker\"}[5m])) / sum(rate(nexus_telemetry_processing_duration_milliseconds_count{exported_job=\"nexus-telemetry-worker\"}[5m]))", "legendFormat": "Average", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(nexus_telemetry_processing_duration_milliseconds_bucket{exported_job=\"nexus-telemetry-worker\"}[5m])))", "legendFormat": "p95", "refId": "B"}
      ]
    },
    {
      "id": 17,
      "title": "Telemetry Failure Handling (Since Worker Start)",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 52, "w": 8, "h": 8},
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0}, "overrides": []},
      "options": {"textMode": "value_and_name", "colorMode": "value", "graphMode": "none"},
      "targets": [
        {"expr": "sum(nexus_telemetry_messages_failed_total{exported_job=\"nexus-telemetry-worker\"}) or vector(0)", "legendFormat": "Failed", "refId": "A"},
        {"expr": "sum(nexus_telemetry_messages_retried_total{exported_job=\"nexus-telemetry-worker\"}) or vector(0)", "legendFormat": "Retried", "refId": "B"},
        {"expr": "sum(nexus_telemetry_messages_dead_lettered_total{exported_job=\"nexus-telemetry-worker\"}) or vector(0)", "legendFormat": "Dead-lettered", "refId": "C"},
        {"expr": "sum(nexus_telemetry_messages_duplicates_total{exported_job=\"nexus-telemetry-worker\"}) or vector(0)", "legendFormat": "Duplicates", "refId": "D"}
      ]
    },
    {
      "id": 18,
      "title": "Telemetry Failure Handling (Cumulative)",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 8, "y": 52, "w": 16, "h": 8},
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0}, "overrides": []},
      "targets": [
        {"expr": "sum(nexus_telemetry_messages_failed_total{exported_job=\"nexus-telemetry-worker\"}) or vector(0)", "legendFormat": "Failed", "refId": "A"},
        {"expr": "sum(nexus_telemetry_messages_retried_total{exported_job=\"nexus-telemetry-worker\"}) or vector(0)", "legendFormat": "Retried", "refId": "B"},
        {"expr": "sum(nexus_telemetry_messages_dead_lettered_total{exported_job=\"nexus-telemetry-worker\"}) or vector(0)", "legendFormat": "Dead-lettered", "refId": "C"},
        {"expr": "sum(nexus_telemetry_messages_duplicates_total{exported_job=\"nexus-telemetry-worker\"}) or vector(0)", "legendFormat": "Duplicates", "refId": "D"}
      ]
    }
  ]
}